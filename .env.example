# Nonsecret environment settings actually read by the implementation.
# The CLI does not automatically load dotenv files. Account, source, database,
# resource caps and timeouts belong in this ignored Settings JSON file.
PREFLIGHT_SETTINGS=/opt/preflight/config/settings.local.json

# Disable automatic SDK telemetry; verify effective deployment behavior.
OTEL_SDK_DISABLED=true

# AWS credentials come from the EC2 instance role, never static keys here.
# Gateway/OpenAI/Daytona credentials belong in native TrueForge settings.
# No MCP auth token is implemented in this controlled demo: loopback transport,
# private SSH UI and literal human tool gates form its documented boundary.
