# Configuration names below are the Preflight project's own implementation contract.
# This is not a populated environment and contains no credentials.
PREFLIGHT_ENV=demo
PREFLIGHT_BACKEND=rds
PREFLIGHT_BIND_HOST=127.0.0.1
PREFLIGHT_BIND_PORT=8000
PREFLIGHT_STATE_DIR=/var/lib/preflight
PREFLIGHT_OPERATOR_CONFIG=/opt/preflight/config/operator-inputs.local.json
PREFLIGHT_ENABLE_SOURCE_APPLY=false
PREFLIGHT_EXPECTED_AWS_ACCOUNT_ID=
AWS_REGION=
PREFLIGHT_SOURCE_INSTANCE_ID=
PREFLIGHT_DATABASE_NAME=preflight_demo
PREFLIGHT_SOURCE_READ_SECRET_ARN=
PREFLIGHT_MIGRATION_WRITER_SECRET_ARN=
PREFLIGHT_RDS_CA_BUNDLE_PATH=
PREFLIGHT_MCP_AUTH_TOKEN=
PREFLIGHT_POSTGRES_MAJOR=18
PREFLIGHT_LOCK_TIMEOUT_MS=3000
PREFLIGHT_MAX_SCRIPT_SECONDS=60
PREFLIGHT_MAX_APPLY_SECONDS=120
PREFLIGHT_MAX_ROWS_PER_TABLE=10000
PREFLIGHT_MAX_BYTES_PER_TABLE=10485760
PREFLIGHT_CLOUD_JOB_TIMEOUT_SECONDS=7200
# AWS runtime credentials come from the EC2 instance role, not static keys here.
# Gateway/OpenAI/Daytona keys are configured in TrueForge provider settings, not this file.
# All timeouts are operator-adjustable safety limits, not performance promises.

# Do not export SQL/tool payloads via automatic SDK tracing. Audit actual SDK instrumentation.
OTEL_SDK_DISABLED=true
